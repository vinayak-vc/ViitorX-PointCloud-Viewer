# embed_worker.cmake - Generates EmbeddedWorker.h from tools/pf360/pf360 (the 360
# reconstruction worker, stdlib-only Python). The exe extracts it on first use to
# %LOCALAPPDATA%\ViitorX\PointForge\worker\<hash>\pf360\ (Recon360.cpp), so a
# single copied exe works without a pf360\ folder beside it.
#
# Inputs: WORKER_DIR (…/tools/pf360/pf360), OUTPUT_HEADER.
# The header is only rewritten when the content changes (no needless rebuilds).

file(GLOB_RECURSE WORKER_FILES RELATIVE "${WORKER_DIR}" "${WORKER_DIR}/*")
list(FILTER WORKER_FILES EXCLUDE REGEX "(^|/)__pycache__/")
list(FILTER WORKER_FILES EXCLUDE REGEX "\\.(pyc|pyo)$")
list(SORT WORKER_FILES)

set(ALL_HEX "")
set(BODY "")
set(TABLE "")
set(i 0)
foreach(REL ${WORKER_FILES})
    file(READ "${WORKER_DIR}/${REL}" HEX HEX)
    string(APPEND ALL_HEX "${REL}:${HEX};")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARR "${HEX}")
    string(APPEND BODY "static const unsigned char pfw_${i}[] = {${ARR}0x00};\n")
    file(SIZE "${WORKER_DIR}/${REL}" SZ)
    string(APPEND TABLE "    {\"${REL}\", pfw_${i}, ${SZ}},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(SHA256 DIGEST "${ALL_HEX}")
string(SUBSTRING "${DIGEST}" 0 16 SHORT)

set(OUT "// Auto-generated by tools/embed_worker.cmake - do not edit.\n#pragma once\n#include <cstddef>\n\n")
string(APPEND OUT "namespace pf_embedded_worker {\n${BODY}\n")
string(APPEND OUT "struct File { const char* path; const unsigned char* data; size_t size; };\n")
string(APPEND OUT "static const File kFiles[] = {\n${TABLE}};\n")
string(APPEND OUT "static const size_t kFileCount = ${i};\n")
string(APPEND OUT "static const char* const kHash = \"${SHORT}\";\n}\n")

set(TMP "${OUTPUT_HEADER}.tmp")
file(WRITE "${TMP}" "${OUT}")
file(COPY_FILE "${TMP}" "${OUTPUT_HEADER}" ONLY_IF_DIFFERENT)
file(REMOVE "${TMP}")
